# Build the 0xMiden/node v0.16.0-rc.3 binaries from source.
#
# 0.16 removed the all-in-one `miden-node bundled` mode: the node is a
# microservice stack of SEPARATE binaries (miden-node sequencer,
# miden-validator, miden-ntx-builder, miden-remote-prover), bootstrapped by
# `genesis` + per-service `bootstrap` subcommands — exactly what the official
# runner (scripts/run-node.sh @ v0.16.0-rc.3) and this repo's
# docker-compose.e2e.yml drive. This image therefore builds ALL of them and
# selects one via the BIN build-arg (upstream Dockerfile's shape: one binary
# per image, BIN + PORT args), instead of carrying a bundled entrypoint.
#
# There is intentionally NO in-image genesis/bootstrap step: the rc.3 genesis
# flow needs the validator signing key + `--validator.key` flags and is owned
# by the compose bootstrap services (see docker-compose.e2e.yml), which mount
# our vendored genesis config (fixtures/genesis/02-with-account-files.toml).
# The old `crates/store/src/genesis/config/samples/02-with-account-files.toml`
# sample no longer exists upstream at rc.3 (only 01-simple.toml), so nothing
# is copied from the repo for that purpose either.

ARG MIDEN_NODE_GIT_URL
ARG MIDEN_NODE_GIT_REF

FROM rust:1.96.1-slim-trixie AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    protobuf-compiler \
    git \
    cmake \
    clang \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Build coords passed via docker-compose build.args; no defaults so a forgotten
# value fails fast with an explicit error.
ARG MIDEN_NODE_GIT_URL
ARG MIDEN_NODE_GIT_REF
RUN test -n "${MIDEN_NODE_GIT_URL}" -a -n "${MIDEN_NODE_GIT_REF}" \
    || (echo "MIDEN_NODE_GIT_URL and MIDEN_NODE_GIT_REF build-args are required" >&2 && exit 1)

RUN git clone "${MIDEN_NODE_GIT_URL}" . && \
    git checkout "${MIDEN_NODE_GIT_REF}"

RUN git rev-parse HEAD > /tmp/miden-node-commit.txt && \
    echo "Ref: ${MIDEN_NODE_GIT_REF}" >> /tmp/miden-node-commit.txt && \
    echo "Url: ${MIDEN_NODE_GIT_URL}" >> /tmp/miden-node-commit.txt

# Build every e2e binary in one cargo invocation (upstream builder-local
# shape): miden-node (sequencer), miden-validator, miden-ntx-builder and
# miden-remote-prover.
RUN cargo build --release \
    --bin miden-node \
    --bin miden-validator \
    --bin miden-ntx-builder \
    --bin miden-remote-prover

# Runtime
FROM debian:trixie-slim

COPY --from=builder /tmp/miden-node-commit.txt /app/miden-node-commit.txt

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ca-certificates \
    libssl3 \
    libsqlite3-0 \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Which binary this image serves — one image per service, mirroring the
# upstream rc.3 Dockerfile (BIN/PORT build-args).
ARG BIN=miden-node
RUN test -n "${BIN}" || (echo "BIN build-arg is required" >&2 && exit 1)
COPY --from=builder /build/target/release/miden-node /usr/local/bin/miden-node
COPY --from=builder /build/target/release/miden-validator /usr/local/bin/miden-validator
COPY --from=builder /build/target/release/miden-ntx-builder /usr/local/bin/miden-ntx-builder
COPY --from=builder /build/target/release/miden-remote-prover /usr/local/bin/miden-remote-prover

ARG PORT=57291
EXPOSE ${PORT}

ENV MIDEN_BIN=${BIN}
CMD ["/bin/sh", "-c", "exec /usr/local/bin/$MIDEN_BIN"]
