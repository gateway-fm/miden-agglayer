+// TestGetPendingDepositsToClaimCrossRollup reproduces the shared-rollup-manager bug
+// where a deposit's exit index collides with another rollup's already-claimed exit at
+// the same index. On a shared AggLayer L1, every rollup claims its L2->L1 exits under
+// network_id = 0, and their deposit_cnt index spaces overlap. The pending-deposits query
+// must disambiguate the claim by its origin (mainnet_flag / rollup_index + 1 = network_id)
+// exactly like GetClaim does, otherwise rollup A's exit #N permanently hides rollup B's
+// exit #N from /pending-bridges (the standalone auto-claimer never sees it).
+//
+// Field case (Bali): our rollup 76 exit #23 was ready & unclaimed, but rollups 44/49/52/57
+// had already claimed their own #23 on L1, so the unqualified query returned 0 rows.
+func TestGetPendingDepositsToClaimCrossRollup(t *testing.T) {
+	// Three of our deposits (origin rollup 76, network_id 76) bridging out to L1 (dest_net 0),
+	// at exit indices 13, 14 and 23, all ready and unclaimed by us.
+	// Plus claims recorded on L1 (network_id 0, mainnet_flag false) for the SAME indices but
+	// belonging to OTHER rollups: #13 by rollup 44 (rollup_index 43), #14 by rollup 49
+	// (rollup_index 48), and #23 by rollups 52 and 57 (rollup_index 51 and 56).
+	data := `INSERT INTO sync.block
+	(id, block_num, block_hash, network_id)
+	VALUES(1, 1, decode('5C7831','hex'), 0);
+
+	INSERT INTO sync.deposit
+	(leaf_type, network_id, orig_net, orig_addr, amount, dest_net, dest_addr, block_id, deposit_cnt, tx_hash, metadata, id, ready_for_claim)
+	VALUES(0, 76, 76, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', 0, decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, 13, decode('CBE7A77275EE22780BB94EA900D42CEF88F5A2F0E1A7C76696556D7FF17767E6','hex'), decode('','hex'), 1, true);
+	INSERT INTO sync.deposit
+	(leaf_type, network_id, orig_net, orig_addr, amount, dest_net, dest_addr, block_id, deposit_cnt, tx_hash, metadata, id, ready_for_claim)
+	VALUES(0, 76, 76, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', 0, decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, 14, decode('6282FACE883070640F802CE8A2C42593AA18D3A691C61BA006EC477D6E5FEE1F','hex'), decode('','hex'), 2, true);
+	INSERT INTO sync.deposit
+	(leaf_type, network_id, orig_net, orig_addr, amount, dest_net, dest_addr, block_id, deposit_cnt, tx_hash, metadata, id, ready_for_claim)
+	VALUES(0, 76, 76, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', 0, decode('F38FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, 23, decode('A382FACE883070640F802CE8A2C42593AA18D3A691C61BA006EC477D6E5FEE1F','hex'), decode('','hex'), 3, true);
+
+	INSERT INTO sync.claim
+	(network_id, "index", orig_net, orig_addr, amount, dest_addr, block_id, tx_hash, rollup_index, mainnet_flag)
+	VALUES(0, 13, 0, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, decode('BF2C816AB6F8A8F5F9DDA6EE97D433CC841E69B5669A5CDF499826FA4B99C179','hex'), 43, false);
+	INSERT INTO sync.claim
+	(network_id, "index", orig_net, orig_addr, amount, dest_addr, block_id, tx_hash, rollup_index, mainnet_flag)
+	VALUES(0, 14, 0, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, decode('BF2C816AB6F8A8F5F9DDA6EE97D433CC841E69B5669A5CDF499826FA4B99C179','hex'), 48, false);
+	INSERT INTO sync.claim
+	(network_id, "index", orig_net, orig_addr, amount, dest_addr, block_id, tx_hash, rollup_index, mainnet_flag)
+	VALUES(0, 23, 0, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, decode('BF2C816AB6F8A8F5F9DDA6EE97D433CC841E69B5669A5CDF499826FA4B99C179','hex'), 51, false);
+	INSERT INTO sync.claim
+	(network_id, "index", orig_net, orig_addr, amount, dest_addr, block_id, tx_hash, rollup_index, mainnet_flag)
+	VALUES(0, 23, 0, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, decode('BF2C816AB6F8A8F5F9DDA6EE97D433CC841E69B5669A5CDF499826FA4B99C179','hex'), 56, false);
+	`
+	dbCfg := NewConfigFromEnv()
+	ctx := context.Background()
+	err := InitOrReset(ctx, dbCfg)
+	require.NoError(t, err)
+
+	store, err := NewPostgresStorage(ctx, dbCfg)
+	require.NoError(t, err)
+
+	_, err = store.Exec(ctx, data)
+	require.NoError(t, err)
+
+	// dest_net = 0 (L1). Despite other rollups having claimed their #13/#14/#23, all three of
+	// our rollup-76 exits must still be pending (none was claimed BY rollup 76).
+	deposits, totalCount, err := store.GetPendingDepositsToClaim(ctx, common.Address{}, 0, 0, 0, 0, -1, nil)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(3), totalCount)
+	require.Equal(t, 3, len(deposits))
+	assert.Equal(t, uint32(13), deposits[0].DepositCount)
+	assert.Equal(t, uint32(14), deposits[1].DepositCount)
+	assert.Equal(t, uint32(23), deposits[2].DepositCount)
+	for _, d := range deposits {
+		assert.Equal(t, uint32(76), d.NetworkID)
+		assert.Equal(t, uint32(0), d.DestinationNetwork)
+	}
+
+	// Now rollup 76 itself claims its exit #23 on L1 (rollup_index 75, i.e. network_id 76).
+	// That claim — and only that claim — must remove deposit #23 from the pending set.
+	_, err = store.Exec(ctx, `INSERT INTO sync.claim
+	(network_id, "index", orig_net, orig_addr, amount, dest_addr, block_id, tx_hash, rollup_index, mainnet_flag)
+	VALUES(0, 23, 0, decode('0000000000000000000000000000000000000000','hex'), '90000000000000000', decode('F39FD6E51AAD88F6F4CE6AB8827279CFFFB92266','hex'), 1, decode('A12C816AB6F8A8F5F9DDA6EE97D433CC841E69B5669A5CDF499826FA4B99C179','hex'), 75, false);`)
+	require.NoError(t, err)
+
+	deposits, totalCount, err = store.GetPendingDepositsToClaim(ctx, common.Address{}, 0, 0, 0, 0, -1, nil)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(2), totalCount)
+	require.Equal(t, 2, len(deposits))
+	assert.Equal(t, uint32(13), deposits[0].DepositCount)
+	assert.Equal(t, uint32(14), deposits[1].DepositCount)
+}
