--- a/autoclaimservice/autoclaim/config.go
+++ b/autoclaimservice/autoclaim/config.go
@@ -15,4 +15,12 @@ type Config struct {
 	MaxNumberOfClaimsPerGroup int `mapstructure:"MaxNumberOfClaimsPerGroup"`
 	// BridgeURL is the URL of the bridge service
 	BridgeURL string `mapstructure:"BridgeURL"`
+	// SourceNetworkID, when set, restricts auto-claiming to bridges that originate from this
+	// network only (matched against each deposit's origin network_id). When unset, bridges
+	// from every source network are claimed (the previous behaviour).
+	//
+	// On a shared AggLayer rollup manager many rollups settle their L2->L1 exits on the same
+	// L1, so the claimer would otherwise sponsor (pay gas for) every co-tenant's exits. Set
+	// this to our own rollup's network id (e.g. Miden) so we only sponsor our own bridges.
+	SourceNetworkID *uint32 `mapstructure:"SourceNetworkID"`
 }
